    {
      "name": "1. Chat (Thí sinh)",
      "item": [
        {
          "name": "Khởi tạo phiên chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Site-Key",
                "value": "{{siteKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat/init",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "init"
              ]
            },
            "description": "Tạo user + phiên mới, trả lời chào + FAQ gợi ý (D1-01). Tự lưu userId, userToken, conversationId, faqId.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status hợp lệ (200)', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const body = pm.response.json();",
                  "if (body.user_id) pm.collectionVariables.set('userId', body.user_id);",
                  "if (body.user_token) pm.collectionVariables.set('userToken', body.user_token);",
                  "if (body.conversation_id) pm.collectionVariables.set('conversationId', body.conversation_id);",
                  "pm.test('Có user_token', () => pm.expect(body.user_token, 'Đặt APP_SECRET_KEY trong .env').to.be.a('string'));",
                  "if (body.faq_suggestions && body.faq_suggestions.length) pm.collectionVariables.set('faqId', body.faq_suggestions[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Gửi câu hỏi (RAG)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Site-Key",
                "value": "{{siteKey}}"
              },
              {
                "key": "X-User-Token",
                "value": "{{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat"
              ]
            },
            "description": "Luồng chính: bảo mật -> FAQ khớp trực tiếp -> RAG (Knowledge Base + Gemini). Trả về answer_status, sources (nguồn trích dẫn), latency_ms.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Bảng A dành cho độ tuổi nào?\",\n  \"user_id\": \"{{userId}}\",\n  \"conversation_id\": \"{{conversationId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status hợp lệ (200)', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const body = pm.response.json();",
                  "if (body.user_id) pm.collectionVariables.set('userId', body.user_id);",
                  "if (body.user_token) pm.collectionVariables.set('userToken', body.user_token);",
                  "if (body.conversation_id) pm.collectionVariables.set('conversationId', body.conversation_id);",
                  "pm.test('Có câu trả lời', () => pm.expect(body.reply).to.be.a('string').and.not.empty);",
                  "pm.test('Có trường sources (RAG) hoặc used_faq', () => pm.expect(body.used_faq === true || Array.isArray(body.sources)).to.be.true);"
                ]
              }
            }
          ]
        },

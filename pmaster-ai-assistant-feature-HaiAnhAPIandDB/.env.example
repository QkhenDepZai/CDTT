# Sao chép thành file .env (KHÔNG commit .env lên Git) rồi điền giá trị thật.

# ---- MySQL ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gemini_chat_db

# ---- Gemini (https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
# Tự chuyển sang model này khi model chính quá tải (503) / hết quota (429)
GEMINI_FALLBACK_MODEL_NAME=gemini-3.5-flash

# ---- Knowledge Base / RAG ----
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_DIMENSION=768
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.55
KNOWLEDGE_UPLOAD_FOLDER=uploads/knowledge
KNOWLEDGE_MAX_FILE_MB=20

# ---- Bảo mật API ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
ADMIN_API_KEY=
ENFORCE_USER_TOKEN=false

# ---- Facebook Messenger (để trống = tắt kênh) ----
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_GRAPH_API_VERSION=v23.0
FB_USE_HUMAN_AGENT_TAG=false

# ---- Zalo OA (để trống = tắt kênh) ----
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_SECRET_KEY=
ZALO_OA_ID=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
CHANNEL_WORKERS=4

# ---- Nghiệp vụ cuộc thi (xác định Bảng A/B) ----
COMPETITION_YEAR=2026
TRACK_A_MIN_AGE=13
TRACK_A_MAX_AGE=18
TRACK_B_MIN_AGE=19
TRACK_B_MAX_AGE=24
SUPPORT_CONTACT_TEXT=Email: info@pythonmaster.vn · Hotline: 0347 314 969 / 0354 549 889

# ---- Giờ trực tư vấn viên (để trống SUPPORT_HOURS = luôn có người trực) ----
# Ngoài giờ: widget hiện form để lại thông tin (ticket) thay vì xếp hàng chờ.
SUPPORT_HOURS=
# 1 = Thứ 2 ... 7 = Chủ nhật, vd "1-5" hoặc "1,2,3,4,5,6"
SUPPORT_DAYS=1-7
SUPPORT_UTC_OFFSET_HOURS=7

# ---- Email thông báo tư vấn viên (để trống = chỉ thông báo trong Staff Dashboard) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
# Nhiều email cách nhau bằng dấu phẩy
STAFF_NOTIFY_EMAILS=
STAFF_DASHBOARD_URL=http://localhost:5000/staff

# Sao chép thành file .env (KHÔNG commit .env lên Git) rồi điền giá trị thật.

# ---- MySQL ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gemini_chat_db

# ---- Gemini (https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
# Tự chuyển sang model này khi model chính quá tải (503) / hết quota (429)
GEMINI_FALLBACK_MODEL_NAME=gemini-3.5-flash

# ---- Knowledge Base / RAG ----
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_DIMENSION=768
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.55
KNOWLEDGE_UPLOAD_FOLDER=uploads/knowledge
KNOWLEDGE_MAX_FILE_MB=20

# ---- Bảo mật API ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
ADMIN_API_KEY=
ENFORCE_USER_TOKEN=false

# ---- Facebook Messenger (để trống = tắt kênh) ----
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_GRAPH_API_VERSION=v23.0
FB_USE_HUMAN_AGENT_TAG=false

# ---- Zalo OA (để trống = tắt kênh) ----
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_SECRET_KEY=
ZALO_OA_ID=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
CHANNEL_WORKERS=4
